# Copy this file to backend/.env and fill in your values.
# The commented `docker run` example passes these as environment variables.

# PostgreSQL connection string (matches docker-compose.yaml credentials).
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/todo

# API prefix used for all routes.
API_PREFIX=/api/v1

# Firebase Admin SDK configuration.
# 1. Create a Firebase project at https://console.firebase.google.com/ and enable
#    the Email/Password sign-in provider in Authentication > Sign-in method.
# 2. Go to Project settings > Service accounts and click "Generate new private key".
#    Save the downloaded JSON file somewhere on disk.
# 3. Point FIREBASE_SERVICE_ACCOUNT_JSON at that file.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON=/absolute/path/to/serviceAccountKey.json

# Optional: restrict accepted tokens to a specific audience/client.
# Leave empty to accept any token from this Firebase project.
FIREBASE_ID_TOKEN_AUDIENCE=
