# How browser API requests are sent:
# - proxy: requests use this Vite server and are forwarded to VITE_PROXY_TARGET
# - direct: requests go from the browser to VITE_API_ORIGIN and require CORS
VITE_API_MODE=proxy

# Used only by direct mode. Provide an origin, without /api/v1.
VITE_API_ORIGIN=http://localhost:8000

# Used by the Vite development proxy for /api and /health.
VITE_PROXY_TARGET=http://localhost:8000

# Firebase Web App configuration from Firebase Console > Project settings >
# General > Your apps. These values identify the browser app; they are not the
# private service-account credentials used by the backend.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id
